{
  "name": "booking-admin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:seed": "tsx prisma/seed.ts",
    "dev:api": "npm run dev -w apps/api",
    "build:api": "npm run build -w apps/api",
    "test:api": "npm run test -w apps/api",
    "db:seed:bookings": "tsx prisma/seed-bookings.ts",
    "gen:bookings": "python3 tools/model-gen/bookings.py"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.16.2",
    "@prisma/client": "6.16.2",
    "bcryptjs": "^3.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prisma": "6.16.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
