# Copy to .env next to docker-compose.yml, then: docker compose up --build
DB_OWNER_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-random
PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false
# Set RUN_SEED=false after the first run to skip demo data
RUN_SEED=true
SEED_PASSWORD=ChangeMe!2026
