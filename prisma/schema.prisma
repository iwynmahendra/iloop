// Generated together with migrations/*/migration.sql from one model definition.
// Supabase: DATABASE_URL = pooled (pgbouncer) URL for the app, DIRECT_URL = direct URL for migrations.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  SUPPLIER_ADMIN
  SUPPLIER_STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ACTIVATE
  DEACTIVATE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  IMPORT
  EXPORT
}

enum AmenityScope {
  HOTEL
  ROOM
  CLUB
  VEHICLE
  TRIP
}

enum CategoryType {
  HOTEL
  TRIP
  TRANSPORT
  CLUB
}

enum CityKind {
  CITY
  AREA
}

enum ChargeType {
  TAX
  SERVICE_CHARGE
}

enum ChargeAppliesTo {
  ALL
  HOTEL
  TRIP
  TRANSPORT
  CLUB
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

enum VehicleKind {
  CAR
  VAN
  BUS
  BOAT
  SCOOTER
  OTHER
}

enum TransportServiceType {
  AIRPORT_TRANSFER
  CHARTER
  SHUTTLE
  FERRY
}

enum VenueKind {
  BEACH_CLUB
  NIGHTCLUB
  LOUNGE
  OTHER
}

/// Tenant root. SUP-0000 is the platform pseudo-supplier that owns shared master data.
model Supplier {
  id                      String                   @id(map: "suppliers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String                   @default(dbgenerated("(('SUP-'::text || lpad((nextval('supplier_code_seq'::regclass))::text, 4, '0'::text)))")) @db.VarChar(20)
  name                    String                   @db.VarChar(200)
  legalName               String?                  @db.VarChar(200) @map("legal_name")
  email                   String                   @db.VarChar(254)
  phone                   String?                  @db.VarChar(40)
  address                 String?
  countryCode             String?                  @db.Char(2) @map("country_code")
  taxId                   String?                  @db.VarChar(60) @map("tax_id")
  commissionPct           Decimal                  @default(0) @db.Decimal(5,2) @map("commission_pct")
  status                  SupplierStatus           @default(ACTIVE)
  logoUrl                 String?                  @map("logo_url")
  isPlatform              Boolean                  @default(false) @map("is_platform")
  createdBy               String?                  @db.Uuid @map("created_by")
  updatedBy               String?                  @db.Uuid @map("updated_by")
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt               DateTime                 @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt               DateTime?                @db.Timestamptz(6) @map("deleted_at")
  country                 Country?                 @relation("Supplier_country", fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "suppliers_country_code_fkey")
  users                   User[]                   @relation("User_supplier")
  emailOutbox             EmailOutbox[]            @relation("EmailOutbox_supplier")
  integrationConnections  IntegrationConnection[] @relation("IntegrationConnection_supplier")
  webhookEndpoints        WebhookEndpoint[]        @relation("WebhookEndpoint_supplier")
  apiKeys                 ApiKey[]                 @relation("ApiKey_supplier")
  cities                  City[]                   @relation("City_supplier")
  amenities               Amenity[]                @relation("Amenity_supplier")
  categories              Category[]               @relation("Category_supplier")
  taxCharges              TaxCharge[]              @relation("TaxCharge_supplier")
  cancellationPolicies    CancellationPolicy[]     @relation("CancellationPolicy_supplier")
  cancellationPolicyRules CancellationPolicyRule[] @relation("CancellationPolicyRule_supplier")
  mediaAssets             MediaAsset[]             @relation("MediaAsset_supplier")
  hotels                  Hotel[]                  @relation("Hotel_supplier")
  hotelAmenities          HotelAmenity[]           @relation("HotelAmenity_supplier")
  hotelImages             HotelImage[]             @relation("HotelImage_supplier")
  roomTypes               RoomType[]               @relation("RoomType_supplier")
  roomTypeAmenities       RoomTypeAmenity[]        @relation("RoomTypeAmenity_supplier")
  roomTypeImages          RoomTypeImage[]          @relation("RoomTypeImage_supplier")
  ratePlans               RatePlan[]               @relation("RatePlan_supplier")
  roomInventories         RoomInventory[]          @relation("RoomInventory_supplier")
  trips                   Trip[]                   @relation("Trip_supplier")
  tripImages              TripImage[]              @relation("TripImage_supplier")
  tripItineraryDaies      TripItineraryDay[]       @relation("TripItineraryDay_supplier")
  tripVariants            TripVariant[]            @relation("TripVariant_supplier")
  tripSchedules           TripSchedule[]           @relation("TripSchedule_supplier")
  tripAddons              TripAddon[]              @relation("TripAddon_supplier")
  vehicleTypes            VehicleType[]            @relation("VehicleType_supplier")
  vehicleTypeAmenities    VehicleTypeAmenity[]     @relation("VehicleTypeAmenity_supplier")
  vehicleTypeImages       VehicleTypeImage[]       @relation("VehicleTypeImage_supplier")
  transportZones          TransportZone[]          @relation("TransportZone_supplier")
  transportServices       TransportService[]       @relation("TransportService_supplier")
  zoneRoutePrices         ZoneRoutePrice[]         @relation("ZoneRoutePrice_supplier")
  drivers                 Driver[]                 @relation("Driver_supplier")
  vehicles                Vehicle[]                @relation("Vehicle_supplier")
  clubs                   Club[]                   @relation("Club_supplier")
  clubOpeningHours        ClubOpeningHour[]        @relation("ClubOpeningHour_supplier")
  clubAmenities           ClubAmenity[]            @relation("ClubAmenity_supplier")
  clubImages              ClubImage[]              @relation("ClubImage_supplier")
  clubTicketTypes         ClubTicketType[]         @relation("ClubTicketType_supplier")
  clubTablePackages       ClubTablePackage[]       @relation("ClubTablePackage_supplier")
  clubEvents              ClubEvent[]              @relation("ClubEvent_supplier")

  customers Customer[] @relation("Customer_supplier") // booking
  bookingSequences BookingSequence[] @relation("BookingSequence_supplier") // booking
  bookings Booking[] @relation("Booking_supplier") // booking
  bookingLines BookingLine[] @relation("BookingLine_supplier") // booking
  bookingGuests BookingGuest[] @relation("BookingGuest_supplier") // booking
  hotelBookingItems HotelBookingItem[] @relation("HotelBookingItem_supplier") // booking
  tripBookingItems TripBookingItem[] @relation("TripBookingItem_supplier") // booking
  transportBookingItems TransportBookingItem[] @relation("TransportBookingItem_supplier") // booking
  clubBookingItems ClubBookingItem[] @relation("ClubBookingItem_supplier") // booking
  payments Payment[] @relation("Payment_supplier") // booking
  bookingEvents BookingEvent[] @relation("BookingEvent_supplier") // booking
  @@unique([code], map: "suppliers_code_key")
  @@index([status], map: "suppliers_status_idx")
  @@index([countryCode], map: "suppliers_country_code_idx")
  @@map("suppliers")
}

model User {
  id                  String               @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId          String?              @db.Uuid @map("supplier_id")
  email               String               @db.VarChar(254)
  passwordHash        String               @map("password_hash")
  name                String               @db.VarChar(120)
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  failedLoginCount    Int                  @default(0) @map("failed_login_count")
  lockedUntil         DateTime?            @db.Timestamptz(6) @map("locked_until")
  lastLoginAt         DateTime?            @db.Timestamptz(6) @map("last_login_at")
  passwordChangedAt   DateTime?            @db.Timestamptz(6) @map("password_changed_at")
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  createdBy           String?              @db.Uuid @map("created_by")
  updatedBy           String?              @db.Uuid @map("updated_by")
  createdAt           DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt           DateTime?            @db.Timestamptz(6) @map("deleted_at")
  supplier            Supplier?            @relation("User_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "users_supplier_id_fkey")
  refreshTokens       RefreshToken[]       @relation("RefreshToken_user")
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetToken_user")

  @@unique([email], map: "users_email_key")
  @@index([supplierId, status], map: "users_supplier_id_status_idx")
  @@map("users")
}

model RefreshToken {
  id           String    @id(map: "refresh_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid @map("user_id")
  familyId     String    @db.Uuid @map("family_id")
  tokenHash    String    @db.VarChar(64) @map("token_hash")
  expiresAt    DateTime  @db.Timestamptz(6) @map("expires_at")
  revokedAt    DateTime? @db.Timestamptz(6) @map("revoked_at")
  replacedById String?   @db.Uuid @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  user         User      @relation("RefreshToken_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "refresh_tokens_user_id_fkey")

  @@unique([tokenHash], map: "refresh_tokens_token_hash_key")
  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id(map: "password_reset_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @db.VarChar(64) @map("token_hash")
  expiresAt DateTime  @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")
  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  user      User      @relation("PasswordResetToken_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@unique([tokenHash], map: "password_reset_tokens_token_hash_key")
  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id        String   @id(map: "login_attempts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(254)
  userId    String?  @db.Uuid @map("user_id")
  ip        String?  @db.VarChar(45)
  success   Boolean
  reason    String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([email, createdAt], map: "login_attempts_email_created_at_idx")
  @@index([ip, createdAt], map: "login_attempts_ip_created_at_idx")
  @@map("login_attempts")
}

/// Append-only. A trigger blocks UPDATE and DELETE. No FKs so history survives purges.
model AuditLog {
  id         String      @id(map: "audit_logs_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String?     @db.Uuid @map("supplier_id")
  userId     String?     @db.Uuid @map("user_id")
  userEmail  String?     @db.VarChar(254) @map("user_email")
  action     AuditAction
  entityType String      @db.VarChar(60) @map("entity_type")
  entityId   String?     @db.Uuid @map("entity_id")
  before     Json?
  after      Json?
  ip         String?     @db.VarChar(45)
  userAgent  String?     @map("user_agent")
  requestId  String?     @db.VarChar(64) @map("request_id")
  createdAt  DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([supplierId, createdAt], map: "audit_logs_supplier_id_created_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_type_entity_id_idx")
  @@index([userId, createdAt], map: "audit_logs_user_id_created_at_idx")
  @@map("audit_logs")
}

/// Global ISO reference data (no supplier_id).
model Country {
  id             String          @id(map: "countries_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String          @db.Char(2)
  iso3           String?         @db.Char(3)
  name           String          @db.VarChar(120)
  phoneCode      String?         @db.VarChar(8) @map("phone_code")
  status         RecordStatus    @default(ACTIVE)
  createdBy      String?         @db.Uuid @map("created_by")
  updatedBy      String?         @db.Uuid @map("updated_by")
  createdAt      DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt      DateTime?       @db.Timestamptz(6) @map("deleted_at")
  suppliers      Supplier[]      @relation("Supplier_country")
  cities         City[]          @relation("City_country")
  hotels         Hotel[]         @relation("Hotel_country")
  trips          Trip[]          @relation("Trip_country")
  transportZones TransportZone[] @relation("TransportZone_country")
  clubs          Club[]          @relation("Club_country")

  @@unique([code], map: "countries_code_key")
  @@map("countries")
}

/// Global ISO 4217 reference data (no supplier_id).
model Currency {
  id                String             @id(map: "currencies_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @db.Char(3)
  name              String             @db.VarChar(80)
  symbol            String             @db.VarChar(8)
  decimals          Int                @default(2)
  status            RecordStatus       @default(ACTIVE)
  createdBy         String?            @db.Uuid @map("created_by")
  updatedBy         String?            @db.Uuid @map("updated_by")
  createdAt         DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt         DateTime?          @db.Timestamptz(6) @map("deleted_at")
  hotels            Hotel[]            @relation("Hotel_currency")
  roomTypes         RoomType[]         @relation("RoomType_currency")
  ratePlans         RatePlan[]         @relation("RatePlan_currency")
  tripVariants      TripVariant[]      @relation("TripVariant_currency")
  tripAddons        TripAddon[]        @relation("TripAddon_currency")
  transportServices TransportService[] @relation("TransportService_currency")
  zoneRoutePrices   ZoneRoutePrice[]   @relation("ZoneRoutePrice_currency")
  clubTicketTypes   ClubTicketType[]   @relation("ClubTicketType_currency")
  clubTablePackages ClubTablePackage[] @relation("ClubTablePackage_currency")
  clubEvents        ClubEvent[]        @relation("ClubEvent_currency")

  bookings Booking[] @relation("Booking_currency") // booking
  payments Payment[] @relation("Payment_currency") // booking
  @@unique([code], map: "currencies_code_key")
  @@map("currencies")
}

model City {
  id             String          @id(map: "cities_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String          @db.Uuid @map("supplier_id")
  code           String          @db.VarChar(60)
  name           String          @db.VarChar(150)
  kind           CityKind        @default(CITY)
  countryCode    String          @db.Char(2) @map("country_code")
  parentId       String?         @db.Uuid @map("parent_id")
  latitude       Decimal?        @db.Decimal(9,6)
  longitude      Decimal?        @db.Decimal(9,6)
  timezone       String?         @db.VarChar(60)
  status         RecordStatus    @default(ACTIVE)
  createdBy      String?         @db.Uuid @map("created_by")
  updatedBy      String?         @db.Uuid @map("updated_by")
  createdAt      DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt      DateTime?       @db.Timestamptz(6) @map("deleted_at")
  supplier       Supplier        @relation("City_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "cities_supplier_id_fkey")
  country        Country         @relation("City_country", fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "cities_country_code_fkey")
  parent         City?           @relation("City_parent", fields: [supplierId, parentId], references: [supplierId, id], onDelete: Restrict, onUpdate: Cascade, map: "cities_supplier_id_parent_id_fkey")
  children       City[]          @relation("City_parent")
  hotels         Hotel[]         @relation("Hotel_city")
  trips          Trip[]          @relation("Trip_city")
  transportZones TransportZone[] @relation("TransportZone_city")
  clubs          Club[]          @relation("Club_city")

  @@unique([supplierId, code], map: "cities_supplier_id_code_key")
  @@unique([supplierId, id], map: "cities_supplier_id_id_key")
  @@index([supplierId, status], map: "cities_supplier_id_status_idx")
  @@index([supplierId, countryCode], map: "cities_supplier_id_country_code_idx")
  @@index([countryCode], map: "cities_country_code_idx")
  @@index([supplierId, parentId], map: "cities_supplier_id_parent_id_idx")
  @@map("cities")
}

model Amenity {
  id                   String               @id(map: "amenities_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId           String               @db.Uuid @map("supplier_id")
  code                 String               @db.VarChar(60)
  name                 String               @db.VarChar(120)
  scope                AmenityScope
  icon                 String?              @db.VarChar(60)
  sortOrder            Int                  @default(0) @map("sort_order")
  status               RecordStatus         @default(ACTIVE)
  createdBy            String?              @db.Uuid @map("created_by")
  updatedBy            String?              @db.Uuid @map("updated_by")
  createdAt            DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime             @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt            DateTime?            @db.Timestamptz(6) @map("deleted_at")
  supplier             Supplier             @relation("Amenity_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "amenities_supplier_id_fkey")
  hotelAmenities       HotelAmenity[]       @relation("HotelAmenity_amenity")
  roomTypeAmenities    RoomTypeAmenity[]    @relation("RoomTypeAmenity_amenity")
  vehicleTypeAmenities VehicleTypeAmenity[] @relation("VehicleTypeAmenity_amenity")
  clubAmenities        ClubAmenity[]        @relation("ClubAmenity_amenity")

  @@unique([supplierId, code], map: "amenities_supplier_id_code_key")
  @@index([supplierId, status], map: "amenities_supplier_id_status_idx")
  @@index([supplierId, scope], map: "amenities_supplier_id_scope_idx")
  @@map("amenities")
}

model Category {
  id          String       @id(map: "categories_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId  String       @db.Uuid @map("supplier_id")
  code        String       @db.VarChar(60)
  name        String       @db.VarChar(120)
  type        CategoryType
  parentId    String?      @db.Uuid @map("parent_id")
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  status      RecordStatus @default(ACTIVE)
  createdBy   String?      @db.Uuid @map("created_by")
  updatedBy   String?      @db.Uuid @map("updated_by")
  createdAt   DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime?    @db.Timestamptz(6) @map("deleted_at")
  supplier    Supplier     @relation("Category_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "categories_supplier_id_fkey")
  parent      Category?    @relation("Category_parent", fields: [supplierId, parentId], references: [supplierId, id], onDelete: Restrict, onUpdate: Cascade, map: "categories_supplier_id_parent_id_fkey")
  children    Category[]   @relation("Category_parent")
  trips       Trip[]       @relation("Trip_category")
  clubs       Club[]       @relation("Club_category")

  @@unique([supplierId, code], map: "categories_supplier_id_code_key")
  @@unique([supplierId, id], map: "categories_supplier_id_id_key")
  @@index([supplierId, status], map: "categories_supplier_id_status_idx")
  @@index([supplierId, type], map: "categories_supplier_id_type_idx")
  @@index([supplierId, parentId], map: "categories_supplier_id_parent_id_idx")
  @@map("categories")
}

model TaxCharge {
  id          String          @id(map: "tax_charges_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId  String          @db.Uuid @map("supplier_id")
  code        String          @db.VarChar(40)
  name        String          @db.VarChar(120)
  type        ChargeType
  ratePct     Decimal         @db.Decimal(5,2) @map("rate_pct")
  isInclusive Boolean         @default(false) @map("is_inclusive")
  appliesTo   ChargeAppliesTo @default(ALL) @map("applies_to")
  status      RecordStatus    @default(ACTIVE)
  createdBy   String?         @db.Uuid @map("created_by")
  updatedBy   String?         @db.Uuid @map("updated_by")
  createdAt   DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime?       @db.Timestamptz(6) @map("deleted_at")
  supplier    Supplier        @relation("TaxCharge_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "tax_charges_supplier_id_fkey")

  @@unique([supplierId, code], map: "tax_charges_supplier_id_code_key")
  @@index([supplierId, status], map: "tax_charges_supplier_id_status_idx")
  @@map("tax_charges")
}

model CancellationPolicy {
  id                String                   @id(map: "cancellation_policies_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId        String                   @db.Uuid @map("supplier_id")
  code              String                   @db.VarChar(40)
  name              String                   @db.VarChar(150)
  description       String?
  status            RecordStatus             @default(ACTIVE)
  createdBy         String?                  @db.Uuid @map("created_by")
  updatedBy         String?                  @db.Uuid @map("updated_by")
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt         DateTime?                @db.Timestamptz(6) @map("deleted_at")
  supplier          Supplier                 @relation("CancellationPolicy_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "cancellation_policies_supplier_id_fkey")
  rules             CancellationPolicyRule[] @relation("CancellationPolicyRule_policy")
  ratePlans         RatePlan[]               @relation("RatePlan_cancellationPolicy")
  trips             Trip[]                   @relation("Trip_cancellationPolicy")
  transportServices TransportService[]       @relation("TransportService_cancellationPolicy")

  bookings Booking[] @relation("Booking_cancellationPolicy") // booking
  @@unique([supplierId, code], map: "cancellation_policies_supplier_id_code_key")
  @@unique([supplierId, id], map: "cancellation_policies_supplier_id_id_key")
  @@index([supplierId, status], map: "cancellation_policies_supplier_id_status_idx")
  @@map("cancellation_policies")
}

model CancellationPolicyRule {
  id               String             @id(map: "cancellation_policy_rules_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
