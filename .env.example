# Copy to .env for local use. On Vercel, enter these in Project Settings > Environment Variables (Vercel does not read .env).
# Full Vercel + Supabase steps: README, "Demo on Vercel (Hobby) + Supabase".

# --- Database (Supabase) ---
# App runtime: the transaction POOLER (port 6543) as the non-superuser role from prisma/sql/roles.sql. Never the postgres role.
DATABASE_URL="postgresql://app_runtime.PROJECT_REF:APP_RUNTIME_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations and seed only: the DIRECT connection (port 5432) as postgres. Not needed on Vercel.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Auth ---
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL_SECONDS="900"   # 15 minutes
REFRESH_TOKEN_TTL_DAYS="7"
COOKIE_SECURE="false"            # true on HTTPS (Vercel)
COOKIE_DOMAIN=""                 # leave empty (also on Vercel); a wrong value breaks login
MAX_FAILED_LOGINS="5"
LOCK_MINUTES="15"

# --- App ---
NODE_ENV="development"           # production on Vercel
PORT="4000"                      # local / Docker only
APP_URL="http://localhost:5173"  # base of password reset links; https://<project>.vercel.app on Vercel
CORS_ORIGIN="http://localhost:5173"   # comma-separated; https://<project>.vercel.app on Vercel
TRUST_PROXY=""                   # 1 behind one proxy (Vercel, Docker behind nginx): correct client IPs for the rate limit
LOG_LEVEL="info"

# --- File storage ---
STORAGE_DRIVER="local"           # local | s3 (s3 on Vercel: Supabase Storage)
UPLOAD_DIR="./uploads"           # local only
PUBLIC_UPLOAD_URL="/uploads"     # local only
# Supabase Storage: Storage > Settings > S3 Connection. The bucket must be public.
S3_ENDPOINT=""                   # https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=""                     # region shown on the S3 Connection page, e.g. ap-southeast-1
S3_BUCKET=""                     # e.g. media
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""                 # https://PROJECT_REF.supabase.co/storage/v1/object/public/media
MAX_UPLOAD_MB="5"                # 4 on Vercel (request bodies over 4.5 MB are rejected)
VITE_MAX_UPLOAD_MB="5"           # read by the web apps at build time; keep equal to MAX_UPLOAD_MB

# --- Background jobs ---
# Seconds between runs on a normal server (0 = off). On Vercel they only switch a job on/off; pg_cron sets the pace.
HOLD_SWEEP_SECONDS="60"
EMAIL_SEND_SECONDS="10"
INTEGRATION_WORKER_SECONDS="15"
# Vercel only: turns on /api/v1/cron/run, which Supabase pg_cron calls each minute. 32+ random characters, not the JWT secret.
CRON_SECRET=""
# Integrations: webhook secrets are derived from this (falls back to JWT_ACCESS_SECRET). Optional, 32+ characters.
WEBHOOK_MASTER_KEY=""

# --- Booking ---
BOOKING_HOLD_MINUTES="60"
CONCIERGE_HOLD_MINUTES="480"
BOOKING_TZ_OFFSET_MINUTES="480"  # UTC+8 (Bali): where "today" starts for boards and cut-offs
TRANSPORT_CLASH_MINUTES="180"

# --- Booking emails ---
# No real mailer yet: emails are only written to the log.
MAIL_FROM="Bookings <no-reply@example.com>"
NOTIFY_GUEST_EMAIL="true"
NOTIFY_SUPPLIER_EMAIL="true"

# --- Guest assistant (optional) ---
# Without a key it answers by keyword search over the hotel's documents.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-sonnet-5-5"
GUEST_TOKEN_HOURS="12"

# --- Seed (local, with DIRECT_URL) ---
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_PASSWORD="ChangeMe!2026"    # change it: these are the demo logins
