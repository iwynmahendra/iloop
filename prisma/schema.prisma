enum PmsStayStatus {
  RESERVED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model IntegrationConnection {
  id         String            @id(map: "integration_connection_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String            @db.Uuid @map("supplier_id")
  kind       IntegrationKind
  provider   String            @db.VarChar(30)
  name       String            @db.VarChar(80)
  status     IntegrationStatus @default(PENDING)
  enabled    Boolean           @default(true)
  config     Json              @default("{}")
  secretRef  String?           @db.VarChar(80) @map("secret_ref")
  lastOkAt   DateTime?         @db.Timestamptz(6) @map("last_ok_at")
  lastSyncAt DateTime?         @db.Timestamptz(6) @map("last_sync_at")
  lastError  String?           @map("last_error")
  createdAt  DateTime          @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt  DateTime          @db.Timestamptz(6) @default(now()) @updatedAt @map("updated_at")
  supplier Supplier @relation("IntegrationConnection_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "integration_connection_supplier_id_fkey")
  externalRefs ExternalRef[] @relation("ExternalRef_connection")
  events IntegrationEvent[] @relation("IntegrationEvent_connection")
  pmsReservations PmsReservation[] @relation("PmsReservation_connection")
  pmsRoomStates PmsRoomState[] @relation("PmsRoomState_connection")
  @@unique([supplierId, kind, provider], map: "integration_connection_supplier_id_kind_provider_key")
  @@unique([supplierId, id], map: "integration_connection_supplier_id_id_key")
  @@map("integration_connection")
}

model WebhookEndpoint {
  id          String   @id(map: "webhook_endpoint_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId  String   @db.Uuid @map("supplier_id")
  url         String   @db.VarChar(500)
  description String?  @db.VarChar(120)
  topics      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  supplier Supplier @relation("WebhookEndpoint_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "webhook_endpoint_supplier_id_fkey")
  events IntegrationEvent[] @relation("IntegrationEvent_webhook")
  @@unique([supplierId, id], map: "webhook_endpoint_supplier_id_id_key")
  @@map("webhook_endpoint")
}

model ExternalRef {
  id           String   @id(map: "external_ref_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId   String   @db.Uuid @map("supplier_id")
  connectionId String   @db.Uuid @map("connection_id")
  entityType   String   @db.VarChar(30) @map("entity_type")
  entityId     String   @db.Uuid @map("entity_id")
  externalId   String   @db.VarChar(100) @map("external_id")
  createdAt    DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  connection IntegrationConnection @relation("ExternalRef_connection", fields: [supplierId, connectionId], references: [supplierId, id], onDelete: Cascade, onUpdate: Cascade, map: "external_ref_supplier_id_connection_id_fkey")
  @@unique([connectionId, entityType, externalId], map: "external_ref_connection_id_entity_type_external_id_key")
  @@unique([connectionId, entityType, entityId], map: "external_ref_connection_id_entity_type_entity_id_key")
  @@map("external_ref")
}

model IntegrationEvent {
  id             String                 @id(map: "integration_event_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String                 @db.Uuid @map("supplier_id")
  connectionId   String?                @db.Uuid @map("connection_id")
  webhookId      String?                @db.Uuid @map("webhook_id")
  direction      EventDirection
  topic          String                 @db.VarChar(60)
  idempotencyKey String                 @db.VarChar(160) @map("idempotency_key")
  payload        Json                   @default("{}")
  status         IntegrationEventStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @db.Timestamptz(6) @default(now()) @map("next_attempt_at")
  lastError      String?                @map("last_error")
  createdAt      DateTime               @db.Timestamptz(6) @default(now()) @map("created_at")
  doneAt         DateTime?              @db.Timestamptz(6) @map("done_at")
  connection IntegrationConnection? @relation("IntegrationEvent_connection", fields: [supplierId, connectionId], references: [supplierId, id], onDelete: Cascade, onUpdate: Cascade, map: "integration_event_supplier_id_connection_id_fkey")
  webhook WebhookEndpoint? @relation("IntegrationEvent_webhook", fields: [supplierId, webhookId], references: [supplierId, id], onDelete: Cascade, onUpdate: Cascade, map: "integration_event_supplier_id_webhook_id_fkey")
  @@unique([supplierId, direction, idempotencyKey], map: "integration_event_idempotency_key")
  @@index([status, nextAttemptAt], map: "integration_event_status_next_attempt_at_idx")
  @@index([supplierId, createdAt], map: "integration_event_supplier_id_created_at_idx")
  @@map("integration_event")
}

model ApiKey {
  id         String    @id(map: "api_key_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String    @db.Uuid @map("supplier_id")
  name       String    @db.VarChar(80)
  prefix     String    @unique(map: "api_key_prefix_key") @db.VarChar(12)
  keyHash    String    @db.Char(64) @map("key_hash")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @db.Timestamptz(6) @map("last_used_at")
  revokedAt  DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt  DateTime  @db.Timestamptz(6) @default(now()) @map("created_at")
  supplier Supplier @relation("ApiKey_supplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "api_key_supplier_id_fkey")
  @@map("api_key")
}

model PmsReservation {
  id             String        @id(map: "pms_reservation_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String        @db.Uuid @map("supplier_id")
  connectionId   String        @db.Uuid @map("connection_id")
  externalId     String        @db.VarChar(100) @map("external_id")
  confirmationNo String?       @db.VarChar(40) @map("confirmation_no")
  guestName      String        @db.VarChar(160) @map("guest_name")
  guestEmail     String?       @db.VarChar(254) @map("guest_email")
  guestPhone     String?       @db.VarChar(40) @map("guest_phone")
  roomType       String?       @db.VarChar(80) @map("room_type")
  roomNo         String?       @db.VarChar(20) @map("room_no")
  arrival        DateTime      @db.Date
  departure      DateTime      @db.Date
  adults         Int           @default(1)
  children       Int           @default(0)
  status         PmsStayStatus @default(RESERVED)
  rateCode       String?       @db.VarChar(40) @map("rate_code")
  balance        Decimal       @db.Decimal(14,2) @default(0)
  syncedAt       DateTime      @db.Timestamptz(6) @default(now()) @map("synced_at")
  connection IntegrationConnection @relation("PmsReservation_connection", fields: [supplierId, connectionId], references: [supplierId, id], onDelete: Cascade, onUpdate: Cascade, map: "pms_reservation_supplier_id_connection_id_fkey")
  @@unique([connectionId, externalId], map: "pms_reservation_connection_id_external_id_key")
  @@index([supplierId, arrival], map: "pms_reservation_supplier_id_arrival_idx")
  @@index([supplierId, departure], map: "pms_reservation_supplier_id_departure_idx")
  @@map("pms_reservation")
}

model PmsRoomState {
  id           String   @id(map: "pms_room_state_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId   String   @db.Uuid @map("supplier_id")
  connectionId String   @db.Uuid @map("connection_id")
  roomNo       String   @db.VarChar(20) @map("room_no")
  foStatus     String   @db.VarChar(20) @default("VACANT") @map("fo_status")
  hkStatus     String   @db.VarChar(20) @default("CLEAN") @map("hk_status")
  syncedAt     DateTime @db.Timestamptz(6) @default(now()) @map("synced_at")
  connection IntegrationConnection @relation("PmsRoomState_connection", fields: [supplierId, connectionId], references: [supplierId, id], onDelete: Cascade, onUpdate: Cascade, map: "pms_room_state_supplier_id_connection_id_fkey")
  @@unique([connectionId, roomNo], map: "pms_room_state_connection_id_room_no_key")
  @@map("pms_room_state")
}
