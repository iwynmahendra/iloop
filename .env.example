# --- Database (Supabase) ---
# Runtime URL: Supavisor/pgbouncer pooled connection, as the NON-superuser role from prisma/sql/roles.sql
DATABASE_URL="postgresql://app_runtime:CHANGE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# Migrations and seed: direct connection as the owner role (postgres)
DIRECT_URL="postgresql://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Auth ---
JWT_ACCESS_SECRET="generate: openssl rand -base64 48"
JWT_REFRESH_SECRET="generate: openssl rand -base64 48"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"          # true in production (HTTPS)
MAX_FAILED_LOGINS="5"
LOCK_MINUTES="15"

# --- App ---
PORT="4000"
APP_URL="http://localhost:5173"      # used in password reset links
TRUST_PROXY=""                   # set to 1 when behind one reverse proxy (needed for correct client IPs / rate limits)
CORS_ORIGIN="http://localhost:5173"

# --- File storage ---
STORAGE_DRIVER="local"          # local | s3
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_URL="/uploads"
S3_PUBLIC_URL=""               # public base URL of the bucket/CDN when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
MAX_UPLOAD_MB="5"

# --- Seed ---
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_PASSWORD="ChangeMe!2026"

# Booking module (optional)
BOOKING_HOLD_MINUTES=60
CONCIERGE_HOLD_MINUTES=480
HOLD_SWEEP_SECONDS=60
BOOKING_TZ_OFFSET_MINUTES=480
TRANSPORT_CLASH_MINUTES=180

# Booking emails (guest and supplier get one for every booking). Without a real mailer they are only logged in development.
MAIL_FROM="Bookings <no-reply@example.com>"
NOTIFY_GUEST_EMAIL=true
NOTIFY_SUPPLIER_EMAIL=true
EMAIL_SEND_SECONDS=10
